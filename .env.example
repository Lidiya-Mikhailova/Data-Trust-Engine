# Data Trust Engine — Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# App
APP_ENV=development
APP_VERSION=0.1.0

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Data Lake (local filesystem for development)
DATA_LAKE_PATH=./data/lake
BRONZE_PATH=bronze
SILVER_PATH=silver
GOLD_PATH=gold
QUARANTINE_PATH=quarantine

# SQLite / Observability DB
SQLITE_PATH=./data/observability.db

# Amazon S3 / Data Lake (production)
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
AWS_REGION=<YOUR_AWS_REGION>
S3_BUCKET=<YOUR_S3_BUCKET>

# Google BigQuery / Warehouse
GOOGLE_APPLICATION_CREDENTIALS=<PATH_TO_SERVICE_ACCOUNT_JSON>
GOOGLE_CLOUD_PROJECT=<YOUR_GCP_PROJECT_ID>
BIGQUERY_DATASET=<YOUR_BIGQUERY_DATASET>

# Dagster — PostgreSQL
DAGSTER_POSTGRES_HOST=dagster_postgres
DAGSTER_POSTGRES_PORT=5432
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
DAGSTER_POSTGRES_DB=dagster
DAGSTER_POSTGRES_EXPORT_PORT=5432

# Dagster — Webserver
DAGSTER_WEBSERVER_PORT=3000
DAGSTER_HOME=/opt/dagster

# LLM / OpenAI
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# Security
SECRET_KEY=<YOUR_SECRET_KEY>
